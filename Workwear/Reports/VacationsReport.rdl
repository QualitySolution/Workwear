<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Отчёт по отпускам сотрудников</Description>
  <Author></Author>
  <PageHeight>8.3in</PageHeight>
  <PageWidth>18in</PageWidth>
  <Width>7.5in</Width>
  <TopMargin>.25in</TopMargin>
  <LeftMargin>.25in</LeftMargin>
  <RightMargin>.25in</RightMargin>
  <BottomMargin>.25in</BottomMargin>
  <DataSets>
    <DataSet Name="Data">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>SELECT
    CONCAT_WS(' ', employees.last_name, employees.first_name, employees.patronymic_name) AS employee,
    employees.personnel_number,
    subdivisions.name AS subdivision,
    departments.name AS department,
    posts.name AS post,
    vacation_type.name AS vacation_type,
    employees_vacations.begin_date,
    employees_vacations.end_date,
    DATEDIFF(employees_vacations.end_date, employees_vacations.begin_date) + 1 AS days,
    employees_vacations.comment
FROM employees_vacations
    JOIN employees ON employees.id = employees_vacations.employee_id
    JOIN vacation_type ON vacation_type.id = employees_vacations.vacation_type_id
    LEFT JOIN subdivisions ON subdivisions.id = employees.subdivision_id
    LEFT JOIN departments ON departments.id = employees.department_id
    LEFT JOIN posts ON posts.id = employees.post_id
WHERE employees_vacations.begin_date &lt;= CONVERT(@end_date, DATE)
    AND employees_vacations.end_date &gt;= CONVERT(@start_date, DATE)
    AND (@vacation_type_id = -1 OR employees_vacations.vacation_type_id = @vacation_type_id)
    AND ((-1 IN (@subdivision_ids)) OR (@without_subdivision AND employees.subdivision_id IS NULL) OR (employees.subdivision_id IN (@subdivision_ids)))
ORDER BY subdivisions.name, departments.name, posts.name,
    employees.last_name, employees.first_name, employees.patronymic_name, employees.id,
    employees_vacations.begin_date</CommandText>
        <QueryParameters>
          <QueryParameter Name="start_date">
            <Value>={?start_date}</Value>
          </QueryParameter>
          <QueryParameter Name="end_date">
            <Value>={?end_date}</Value>
          </QueryParameter>
          <QueryParameter Name="vacation_type_id">
            <Value>={?vacation_type_id}</Value>
          </QueryParameter>
          <QueryParameter Name="subdivision_ids">
            <Value>={?subdivision_ids}</Value>
          </QueryParameter>
          <QueryParameter Name="without_subdivision">
            <Value>={?without_subdivision}</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="employee">
          <DataField>employee</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="personnel_number">
          <DataField>personnel_number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="subdivision">
          <DataField>subdivision</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="department">
          <DataField>department</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="post">
          <DataField>post</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="vacation_type">
          <DataField>vacation_type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="begin_date">
          <DataField>begin_date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="end_date">
          <DataField>end_date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="days">
          <DataField>days</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="comment">
          <DataField>comment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
