    <ReportItems>
      <Textbox Name="Textbox21">
        <Height>12.00pt</Height>
        <Width>266.47pt</Width>
        <Value>Распечатано из QS: Спецодежда workwear.qsolution.ru</Value>
        <ZIndex>1</ZIndex>
        <Left>306.1pt</Left>
        <Top>1pt</Top>
        <Style>
          <BorderStyle />
          <BorderColor />
          <BorderWidth />
        </Style>
