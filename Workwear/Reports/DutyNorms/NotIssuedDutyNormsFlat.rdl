      <Textbox Name="TextboxPromo">
        <Height>12pt</Height>
        <Width>265.73pt</Width>
        <Value>Распечатано из QS: Спецодежда workwear.qsolution.ru</Value>
        <ZIndex>1</ZIndex>
        <Left>1724.27pt</Left>
        <Top>1pt</Top>
        <Style>
          <BorderStyle />
          <BorderColor />
          <BorderWidth />
        </Style>
        <CanGrow>true</CanGrow>
