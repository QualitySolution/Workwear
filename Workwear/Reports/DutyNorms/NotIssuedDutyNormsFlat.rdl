  <DataElementName>Report</DataElementName>
  <DataElementStyle>AttributeNormal</DataElementStyle>
  <DataSets>
    <DataSet Name="Data">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <Timeout>1500</Timeout>
        <CommandText>
SELECT
    duty_norms.id AS duty_norm_id,
    duty_norms.name AS duty_norm_name,
    IF(leaders.id IS NOT NULL, CONCAT_WS(' ', leaders.surname, leaders.name, leaders.patronymic),
       IF(employees.id IS NOT NULL, CONCAT_WS(' ', employees.last_name, employees.first_name, employees.patronymic_name),
          NULL)
    ) AS responsible,
    subdivisions.id AS subdivision_id,
    subdivisions.name AS subdivision_name,
    duty_norm_items.protection_tools_id,
    protection_tools.name AS protection_tools_name,
    measurement_units.name AS unit,
    duty_norm_items.next_issue,
    DATEDIFF(CONVERT(@report_date, DATE), duty_norm_items.next_issue) AS delay,
    (SELECT MAX(l_op.operation_time) FROM operation_issued_by_duty_norm AS l_op
     WHERE l_op.duty_norm_item_id = duty_norm_items.id AND l_op.issued &gt; 0) AS last_issue,
    duty_norm_items.amount AS amount_by_norm,
    IFNULL(balance.amount, 0) AS amount_balance,
    GREATEST(CAST(duty_norm_items.amount AS SIGNED) - IFNULL(balance.amount, 0), 0) AS need,
    protection_tools.assessed_cost * GREATEST(CAST(duty_norm_items.amount AS SIGNED) - IFNULL(balance.amount, 0), 0) AS protection_tools_assessed_cost,
    IF(@show_stock, IFNULL(stock.amount, 0), NULL) AS in_stock,
    duty_norm_items.norm_paragraph,
    shipments.shipment_periods
FROM duty_norm_items
        JOIN duty_norms ON duty_norms.id = duty_norm_items.duty_norm_id
        JOIN protection_tools ON protection_tools.id = duty_norm_items.protection_tools_id
        LEFT JOIN item_types ON protection_tools.item_types_id = item_types.id
        LEFT JOIN measurement_units ON item_types.units_id = measurement_units.id
        LEFT JOIN subdivisions ON duty_norms.subdivision_id = subdivisions.id
        LEFT JOIN leaders ON duty_norms.responsible_leder_id = leaders.id
        LEFT JOIN employees ON duty_norms.responsible_employee_id = employees.id
        #Числится по строке дежурной нормы. Как в IssueGraph: без даты автосписания (до износа) числится всегда.
        #Возвраты и списания агрегируем до одной строки на выдачу, чтобы не размножать выданное.
        LEFT JOIN (SELECT b_op.duty_norm_item_id,
                          SUM(b_op.issued - IFNULL(b_wo.returned, 0)) AS amount
                   FROM operation_issued_by_duty_norm AS b_op
                            LEFT JOIN (SELECT wo.issued_operation_id, SUM(wo.returned) AS returned
                                       FROM operation_issued_by_duty_norm AS wo
                                       WHERE wo.issued_operation_id IS NOT NULL
                                       GROUP BY wo.issued_operation_id
                            ) AS b_wo ON b_wo.issued_operation_id = b_op.id
                   WHERE b_op.issued &gt; 0
                     AND b_op.duty_norm_item_id IS NOT NULL
                     AND (b_op.auto_writeoff_date IS NULL OR b_op.auto_writeoff_date &gt; CONVERT(@report_date, DATE))
                   GROUP BY b_op.duty_norm_item_id
            ) AS balance ON balance.duty_norm_item_id = duty_norm_items.id
        #Остатки на складе. У дежурной нормы нет пола и размеров, поэтому считаем всё по номенклатурам позиции.
        LEFT JOIN (SELECT sptn.protection_tools_id AS ptid,
                          SUM(IF(sopwh.warehouse_receipt_id IS NOT NULL AND
                                 (@all_warehouse OR sopwh.warehouse_receipt_id = @warehouse_id), sopwh.amount, 0))
                              - SUM(IF(sopwh.warehouse_expense_id IS NOT NULL AND
                                       (@all_warehouse OR sopwh.warehouse_expense_id = @warehouse_id), sopwh.amount, 0)) AS amount
                   FROM protection_tools_nomenclature AS sptn
                            JOIN operation_warehouse AS sopwh ON sopwh.nomenclature_id = sptn.nomenclature_id
                   WHERE @show_stock
                     AND sopwh.operation_time &lt; ADDDATE(@report_date, INTERVAL 1 DAY)
                     AND (!@hide_worn OR sopwh.wear_percent = 0.00)
                     AND (@all_warehouse
                         OR sopwh.warehouse_receipt_id = @warehouse_id
                         OR sopwh.warehouse_expense_id = @warehouse_id)
                     AND ((-1 IN (@protection_tools_ids)) OR sptn.protection_tools_id IN (@protection_tools_ids))
                   GROUP BY sptn.protection_tools_id
            ) AS stock ON stock.ptid = duty_norm_items.protection_tools_id
        #Незакрытые поставки по номенклатурам позиции. Агрегируем до одной строки на позицию.
        LEFT JOIN (SELECT ship_ptn.protection_tools_id,
                          GROUP_CONCAT(DISTINCT
                              IFNULL(ship.period,
                                  IF(ship.start_period IS NULL AND ship.end_period IS NULL, NULL,
                                      CONCAT('№', ship.shipment_id,
                                             ' (', CONCAT_WS(' - ', DATE_FORMAT(ship.start_period, '%d.%m.%y'),
                                                   NULLIF(DATE_FORMAT(ship.end_period, '%d.%m.%y'), DATE_FORMAT(ship.start_period, '%d.%m.%y'))),
                                             ')',
                                             IFNULL(CONCAT(' ', NULLIF(ship.comment, '')), ''))))
                              SEPARATOR ', ') AS shipment_periods
                   FROM protection_tools_nomenclature AS ship_ptn
                            JOIN (SELECT shipment_items.nomenclature_id,
                                         shipment.id AS shipment_id,
                                         MAX(shipment.start_period) AS start_period,
                                         MAX(shipment.end_period) AS end_period,
                                         MAX(shipment.comment) AS comment,
                                         #Период по строкам поставки, если он задан, иначе ниже берётся период самой поставки.
                                         IF(MIN(shipment_items.start_period) IS NULL OR MAX(shipment_items.end_period) IS NULL, NULL,
                                             CONCAT('№', shipment.id,
                                                    ' (', CONCAT_WS(' - ', DATE_FORMAT(MIN(shipment_items.start_period), '%d.%m.%y'),
                                                          NULLIF(DATE_FORMAT(MAX(shipment_items.end_period), '%d.%m.%y'), DATE_FORMAT(MIN(shipment_items.start_period), '%d.%m.%y'))),
                                                    ')',
                                                    IFNULL(CONCAT(' ', NULLIF(MAX(shipment.comment), '')), ''))) AS period
                                  FROM shipment_items
                                           JOIN shipment ON shipment_items.shipment_id = shipment.id
                                  WHERE @show_shipment
                                    AND shipment.status NOT LIKE 'Received'
                                  GROUP BY shipment_items.nomenclature_id, shipment.id
                            ) AS ship ON ship.nomenclature_id = ship_ptn.nomenclature_id
                   WHERE @show_shipment
                     AND ((-1 IN (@protection_tools_ids)) OR ship_ptn.protection_tools_id IN (@protection_tools_ids))
                   GROUP BY ship_ptn.protection_tools_id
            ) AS shipments ON shipments.protection_tools_id = duty_norm_items.protection_tools_id
WHERE
    duty_norms.archival = 0
  AND ((-1 IN (@subdivisions)) OR (@withoutsub AND duty_norms.subdivision_id IS NULL) OR duty_norms.subdivision_id IN (@subdivisions))
  AND ((-1 IN (@protection_tools_ids)) OR duty_norm_items.protection_tools_id IN (@protection_tools_ids))
  AND duty_norm_items.next_issue &lt;= CONVERT(@report_date, DATE)
  AND (@exclude_before IS NULL OR @exclude_before = '' OR CONVERT(@exclude_before, DATE) &lt; duty_norm_items.next_issue)
  AND duty_norm_items.amount &gt; IFNULL(balance.amount, 0)
  AND (@exclude_zero_stock = false OR stock.amount &gt; 0)
ORDER BY
    subdivision_name,
    duty_norm_name,
    protection_tools_name</CommandText>
        <QueryParameters>
          <QueryParameter Name="@report_date">
            <Value>={?report_date}</Value>
          </QueryParameter>
          <QueryParameter Name="@subdivisions">
            <Value>={?subdivisions}</Value>
          </QueryParameter>
          <QueryParameter Name="@withoutsub">
            <Value>={?withoutsub}</Value>
          </QueryParameter>
          <QueryParameter Name="@protection_tools_ids">
            <Value>={?protection_tools_ids}</Value>
          </QueryParameter>
          <QueryParameter Name="@exclude_before">
            <Value>={?exclude_before}</Value>
          </QueryParameter>
          <QueryParameter Name="@exclude_zero_stock">
            <Value>={?exclude_zero_stock}</Value>
          </QueryParameter>
          <QueryParameter Name="@show_stock">
            <Value>={?show_stock}</Value>
          </QueryParameter>
          <QueryParameter Name="@hide_worn">
            <Value>={?hide_worn}</Value>
          </QueryParameter>
          <QueryParameter Name="@all_warehouse">
            <Value>={?all_warehouse}</Value>
          </QueryParameter>
          <QueryParameter Name="@warehouse_id">
            <Value>={?warehouse_id}</Value>
          </QueryParameter>
          <QueryParameter Name="@show_shipment">
            <Value>={?show_shipment}</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="duty_norm_id">
          <DataField>duty_norm_id</DataField>
