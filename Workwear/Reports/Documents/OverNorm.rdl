  <DataElementName>Report</DataElementName>
  <DataElementStyle>AttributeNormal</DataElementStyle>
  <DataSets>
    <DataSet Name="Data">
      <Query >
        <DataSourceName>DS1</DataSourceName>
        <CommandText>SELECT
    (SELECT GROUP_CONCAT(DISTINCT barcodes.title ORDER BY barcodes.title SEPARATOR '\n')
     FROM operation_barcodes
              JOIN barcodes ON barcodes.id = operation_barcodes.barcode_id
     WHERE operation_barcodes.over_norm_operation_id = operation_over_norm.id)      AS barcode,
    CONCAT_WS(' ', employees.last_name, employees.first_name, employees.patronymic_name) AS fio,
    nomenclature.name                                                              AS nomenclature_name,
    wear_size.name                                                                 AS size,
    wear_height.name                                                               AS height,
    warehouse_operation.amount                                                     AS amount,
    CONCAT(ROUND(warehouse_operation.wear_percent * 100), ' %')                     AS wear_percent
FROM stock_over_norm_items
         JOIN operation_over_norm ON operation_over_norm.id = stock_over_norm_items.over_norm_operation_id
         JOIN operation_warehouse AS warehouse_operation ON warehouse_operation.id = operation_over_norm.operation_warehouse_id
         LEFT JOIN employees ON employees.id = operation_over_norm.employee_id
         LEFT JOIN nomenclature ON nomenclature.id = COALESCE(warehouse_operation.nomenclature_id, operation_over_norm.nomenclature_id)
         LEFT JOIN sizes AS wear_size ON wear_size.id = COALESCE(warehouse_operation.size_id, operation_over_norm.size_id)
         LEFT JOIN sizes AS wear_height ON wear_height.id = COALESCE(warehouse_operation.height_id, operation_over_norm.height_id)
WHERE stock_over_norm_items.document_id = @id
ORDER BY employees.last_name, employees.first_name, employees.patronymic_name, nomenclature.name, stock_over_norm_items.id</CommandText>
        <QueryParameters>
          <QueryParameter Name="id">
            <Value>={?id}</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields >
        <Field Name="barcode">
          <DataField>barcode</DataField>
          <TypeName>System.String</TypeName>
        </Field>
        <Field Name="fio">
          <DataField>fio</DataField>
          <TypeName>System.String</TypeName>
        </Field>
        <Field Name="nomenclature_name">
          <DataField>nomenclature_name</DataField>
          <TypeName>System.String</TypeName>
        </Field>
        <Field Name="size">
          <DataField>size</DataField>
          <TypeName>System.String</TypeName>
        </Field>
        <Field Name="height">
          <DataField>height</DataField>
          <TypeName>System.String</TypeName>
        </Field>
        <Field Name="amount">
          <DataField>amount</DataField>
          <TypeName>System.Int32</TypeName>
        </Field>
        <Field Name="wear_percent">
          <DataField>wear_percent</DataField>
          <TypeName>System.String</TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DocInfo">
      <Query >
        <DataSourceName>DS1</DataSourceName>
        <CommandText>SELECT
    IFNULL(stock_over_norms.doc_number, stock_over_norms.id) AS doc_number,
    stock_over_norms.date                                    AS doc_date,
    CASE stock_over_norms.type
        WHEN 'Simple' THEN 'Лист учёта разовой выдачи'
        WHEN 'Substitute' THEN 'Лист учёта подменной выдачи'
        WHEN 'Guest' THEN 'Лист учёта гостевой выдачи'
        ELSE 'Лист учёта выдачи вне нормы'
        END                                                  AS doc_type_name
FROM stock_over_norms
WHERE stock_over_norms.id = @id</CommandText>
        <QueryParameters>
          <QueryParameter Name="id">
            <Value>={?id}</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields >
        <Field Name="doc_number">
          <DataField>doc_number</DataField>
          <TypeName>System.String</TypeName>
        </Field>
        <Field Name="doc_date">
          <DataField>doc_date</DataField>
          <TypeName>System.DateTime</TypeName>
        </Field>
        <Field Name="doc_type_name">
          <DataField>doc_type_name</DataField>
          <TypeName>System.String</TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>MySqlConnector</DataProvider>
        <ConnectString>database=workwear_agronom_copy;user=;password=;server=office.qsolution.ru;port=3306</ConnectString>
        <IntegratedSecurity>false</IntegratedSecurity>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <ReportParameters>
    <ReportParameter Name="id">
      <DataType>Integer</DataType>
      <DefaultValue>
        <Values>
          <Value>142</Value>
        </Values>
      </DefaultValue>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
      <MultiValue>false</MultiValue>
      <Prompt></Prompt>
    </ReportParameter>
  </ReportParameters>
</Report>