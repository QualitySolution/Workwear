<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description></Description>
  <Author></Author>
  <PageHeight>11in</PageHeight>
  <PageWidth>37in</PageWidth>
  <Width>7.5in</Width>
  <TopMargin>.25in</TopMargin>
  <LeftMargin>.25in</LeftMargin>
  <RightMargin>.25in</RightMargin>
  <BottomMargin>.25in</BottomMargin>
  <DataSets>
    <DataSet Name="Data">
      <Query >
        <DataSourceName>DS1</DataSourceName>
        <CommandText>SELECT *
FROM (
SELECT
    -- Источник вещи определяется последней операцией штрихкода.
    CASE
        WHEN warehouse.id IS NOT NULL THEN 'Warehouse'
        WHEN duty_norms.id IS NOT NULL THEN 'DutyNorm'
        WHEN over_norm.id IS NOT NULL THEN 'OverNorm'
        ELSE 'Employee'
    END AS source_type,
    clothing_service_claim.id AS claim_id,
    CASE
        WHEN warehouse.id IS NOT NULL THEN CONCAT('Склад ', warehouse.name)
        WHEN duty_norms.id IS NOT NULL THEN TRIM(CONCAT('Дежурная №', duty_norms.id, ' ',
            CONCAT_WS(' ',
                IF(duty_norms.responsible_employee_id IS NOT NULL, responsible_employee.last_name, responsible_leader.surname),
                CONCAT_WS('',
                    CONCAT(NULLIF(LEFT(IF(duty_norms.responsible_employee_id IS NOT NULL, responsible_employee.first_name, responsible_leader.name), 1), ''), '.'),
                    CONCAT(NULLIF(LEFT(IF(duty_norms.responsible_employee_id IS NOT NULL, responsible_employee.patronymic_name, responsible_leader.patronymic), 1), ''), '.')))))
        WHEN over_norm.id IS NOT NULL THEN CONCAT_WS(' ',
            CASE over_norm.type
                WHEN 'Guest' THEN 'Гостевая'
                WHEN 'Substitute' THEN 'Подменная'
                WHEN 'Simple' THEN 'Разовая'
                ELSE over_norm.type END,
            employees.last_name,
            CONCAT_WS('',
                CONCAT(NULLIF(LEFT(employees.first_name, 1), ''), '.'),
                CONCAT(NULLIF(LEFT(employees.patronymic_name, 1), ''), '.')))
        ELSE CONCAT_WS(' ', employees.last_name, employees.first_name, employees.patronymic_name)
    END AS FIO,
    employees.personnel_number AS tab,
    IF(duty_norms.id IS NOT NULL, responsible_employee.phone_number, employees.phone_number) AS phone,
    subdivisions.name AS subdivision,
    departments.name AS department,
    barcodes.title AS barcode,
    nomenclature.name AS nomenclature_name,
    IF(clothing_service_claim.need_for_repair, 'Да', '') AS need_for_repair,
    clothing_service_claim.defect,

    DATE_FORMAT(inRecTerm.operation_time, '%d.%m.%Y') AS dateRepTer,
    DATE_FORMAT(aWait.operation_time, '%d.%m.%Y') AS dateAWait,
    count_working_days(
            IFNULL(inRecTerm.operation_time,
                   aWait.operation_time),
            IFNULL(dlvLaund.operation_time,
                   IFNULL(inWash.operation_time,
                          IFNULL(inDry.operation_time,
                                 IFNULL(inRep.operation_time,
                                        IFNULL(dlvDisp.operation_time,
                                               IFNULL(inDispTerm.operation_time,
                                                      NOW()))))))
    )
    AS dayWaitServ,
    DATE_FORMAT(dlvLaund.operation_time, '%d.%m.%Y') AS dateDlvLaund,
    count_working_days(
            dlvLaund.operation_time,
            IFNULL(inWash.operation_time, 
                   IFNULL(inDry.operation_time, 
                          inRep.operation_time))
    ) AS dayDlvLaund,
    DATE_FORMAT(inWash.operation_time, '%d.%m.%Y') AS dateInWash,
    count_working_days(
            inWash.operation_time,
            IFNULL(inDry.operation_time,
                   IFNULL(inRep.operation_time,
                          IFNULL(dlvDisp.operation_time,
                                 IFNULL(inDispTerm.operation_time,
                                        IFNULL(ret.operation_time,
                                               NOW())))))
    ) AS dayWash,
    DATE_FORMAT(inDry.operation_time, '%d.%m.%Y') AS dateInDry,
    count_working_days(
            inDry.operation_time,
            IFNULL(inRep.operation_time, 
                   IFNULL(dlvDisp.operation_time,
                          IFNULL(inDispTerm.operation_time,
                                 IFNULL(ret.operation_time,
                                        NOW()))))
    ) AS dayDry,
    DATE_FORMAT(inRep.operation_time, '%d.%m.%Y') AS dateInRep,
    count_working_days(
            inRep.operation_time,
            IFNULL(dlvDisp.operation_time,
                   IFNULL(inDispTerm.operation_time,
                          IFNULL(ret.operation_time,
                                 NOW())))
    ) AS dayRep,
    DATE_FORMAT(dlvDisp.operation_time, '%d.%m.%Y') AS dateDlvDisp,
    count_working_days(
            dlvDisp.operation_time,
            IFNULL(inDispTerm.operation_time,
                   IFNULL(ret.operation_time, NOW()))
    ) AS dayDlvDisp,
    DATE_FORMAT(inDispTerm.operation_time, '%d.%m.%Y') AS dateInDisp,
    count_working_days(
            inDispTerm.operation_time,
            IFNULL(ret.operation_time, NOW())
    ) AS dayDisp,
    DATE_FORMAT(ret.operation_time, '%d.%m.%Y') AS dateRet,
    count_working_days(
            start.operation_time,
            IFNULL(inDispTerm.operation_time,
                   IFNULL(ret.operation_time, NOW()))
    ) AS dayService,
    count_working_days(
            start.operation_time,
            IF(clothing_service_claim.is_closed, finish.operation_time, NOW())
    ) AS lifeTime
FROM clothing_service_claim     
         LEFT JOIN (select s.claim_id AS clid, MIN(s.id) AS st_id FROM clothing_service_states AS s GROUP BY s.claim_id
                    ) AS t1 ON t1.clid = clothing_service_claim.id
            LEFT JOIN clothing_service_states AS start ON start.id = t1.st_id
         LEFT JOIN (select s.claim_id AS clid, MAX(s.id) AS st_id FROM clothing_service_states AS s GROUP BY s.claim_id
                    ) AS t2 ON t2.clid = clothing_service_claim.id
            LEFT JOIN clothing_service_states AS finish ON finish.id = t2.st_id
         LEFT JOIN (select s.claim_id AS clid, MIN(s.id) AS st_id FROM clothing_service_states AS s WHERE s.state = 'InReceiptTerminal' GROUP BY s.claim_id
                    ) AS t3 ON t3.clid = clothing_service_claim.id
            LEFT JOIN clothing_service_states AS inRecTerm ON inRecTerm.id = t3.st_id
         LEFT JOIN (select s.claim_id AS clid, MIN(s.id) AS st_id FROM clothing_service_states AS s WHERE s.state = 'DeliveryToLaundry' GROUP BY s.claim_id
                    ) AS t4 ON t4.clid = clothing_service_claim.id
            LEFT JOIN clothing_service_states AS dlvLaund ON dlvLaund.id = t4.st_id
         LEFT JOIN (select s.claim_id AS clid, MIN(s.id) AS st_id FROM clothing_service_states AS s WHERE s.state = 'InWashing' GROUP BY s.claim_id
                    ) AS t5 ON t5.clid = clothing_service_claim.id
            LEFT JOIN clothing_service_states AS inWash ON inWash.id = t5.st_id
         LEFT JOIN (select s.claim_id AS clid, MIN(s.id) AS st_id FROM clothing_service_states AS s WHERE s.state = 'InDryCleaning' GROUP BY s.claim_id
                    ) AS t6 ON t6.clid = clothing_service_claim.id
            LEFT JOIN clothing_service_states AS inDry ON inDry.id = t6.st_id
         LEFT JOIN (select s.claim_id AS clid, MIN(s.id) AS st_id FROM clothing_service_states AS s WHERE s.state = 'InRepair' GROUP BY s.claim_id
                    ) AS t7 ON t7.clid = clothing_service_claim.id
            LEFT JOIN clothing_service_states AS inRep ON inRep.id = t7.st_id
         LEFT JOIN (select s.claim_id AS clid, MIN(s.id) AS st_id FROM clothing_service_states AS s WHERE s.state = 'DeliveryToDispenseTerminal' GROUP BY s.claim_id
                    ) AS t8 ON t8.clid = clothing_service_claim.id
            LEFT JOIN clothing_service_states AS dlvDisp ON dlvDisp.id = t8.st_id
         LEFT JOIN (select s.claim_id AS clid, MIN(s.id) AS st_id FROM clothing_service_states AS s WHERE s.state = 'InDispenseTerminal' GROUP BY s.claim_id
                    ) AS t9 ON t9.clid = clothing_service_claim.id
            LEFT JOIN clothing_service_states AS inDispTerm ON inDispTerm.id = t9.st_id
         LEFT JOIN (select s.claim_id AS clid, MIN(s.id) AS st_id FROM clothing_service_states AS s WHERE s.state = 'Returned' GROUP BY s.claim_id
                    ) AS t10 ON t10.clid = clothing_service_claim.id
            LEFT JOIN clothing_service_states AS ret ON ret.id = t10.st_id
         LEFT JOIN (select s.claim_id AS clid, MIN(s.id) AS st_id FROM clothing_service_states AS s WHERE s.state = 'WaitService' GROUP BY s.claim_id
                    ) AS t11 ON t11.clid = clothing_service_claim.id
            LEFT JOIN clothing_service_states AS aWait ON aWait.id = t11.st_id
    
         LEFT JOIN postomat_document_items ON clothing_service_claim.id = postomat_document_items.claim_id
         LEFT JOIN postomat_documents ON postomat_document_items.document_id = postomat_documents.id
    
         LEFT JOIN barcodes ON clothing_service_claim.barcode_id = barcodes.id
         LEFT JOIN operation_barcodes AS last_operation ON last_operation.id = (
             SELECT ob.id
             FROM operation_barcodes AS ob
                      LEFT JOIN operation_issued_by_employee AS oe ON oe.id = ob.employee_issue_operation_id
                      LEFT JOIN operation_issued_by_duty_norm AS od ON od.id = ob.duty_norm_issue_operation_id
                      LEFT JOIN operation_over_norm AS oo ON oo.id = ob.over_norm_operation_id
                      LEFT JOIN operation_warehouse AS ow ON ow.id = ob.warehouse_operation_id
             WHERE ob.barcode_id = barcodes.id
             ORDER BY COALESCE(oe.operation_time, od.operation_time, oo.operation_time, ow.operation_time) DESC, ob.id DESC
             LIMIT 1
         )
         LEFT JOIN operation_warehouse AS last_warehouse ON last_warehouse.id = last_operation.warehouse_operation_id
         LEFT JOIN warehouse ON warehouse.id = last_warehouse.warehouse_receipt_id
         LEFT JOIN operation_issued_by_duty_norm AS duty_operation ON duty_operation.id = last_operation.duty_norm_issue_operation_id
             AND duty_operation.issued &gt; 0 AND warehouse.id IS NULL
         LEFT JOIN duty_norms ON duty_norms.id = duty_operation.duty_norm_id
         LEFT JOIN leaders AS responsible_leader ON responsible_leader.id = duty_norms.responsible_leder_id
         LEFT JOIN employees AS responsible_employee ON responsible_employee.id = COALESCE(duty_norms.responsible_employee_id, responsible_leader.employee_id)
         LEFT JOIN operation_over_norm AS over_norm ON over_norm.id = last_operation.over_norm_operation_id
             AND warehouse.id IS NULL
         LEFT JOIN employees ON employees.id = CASE
             WHEN warehouse.id IS NOT NULL OR duty_norms.id IS NOT NULL THEN NULL
             WHEN over_norm.id IS NOT NULL THEN over_norm.employee_id
             ELSE clothing_service_claim.employee_id END
         LEFT JOIN subdivisions ON subdivisions.id = IF(duty_norms.id IS NOT NULL, duty_norms.subdivision_id, employees.subdivision_id)
         LEFT JOIN departments ON employees.department_id = departments.id
         LEFT JOIN nomenclature ON barcodes.nomenclature_id = nomenclature.id
WHERE 
    (@show_closed OR NOT clothing_service_claim.is_closed)
    AND (NOT @show_closed OR (start.operation_time &gt;= CONVERT(@start_date, DATE) AND start.operation_time &lt; DATE_ADD(CONVERT(@finish_date, DATE), INTERVAL 1 DAY)))
) AS claims
WHERE (claims.source_type = 'Employee' AND @source_employee)
   OR (claims.source_type = 'DutyNorm' AND @source_duty)
   OR (claims.source_type = 'OverNorm' AND @source_over_norm)
   OR (claims.source_type = 'Warehouse' AND @source_warehouse)</CommandText>
        <QueryParameters>
          <QueryParameter Name="source_employee">
            <Value>=Parameters!source_employee</Value>
          </QueryParameter>
          <QueryParameter Name="source_duty">
            <Value>=Parameters!source_duty</Value>
          </QueryParameter>
          <QueryParameter Name="source_over_norm">
            <Value>=Parameters!source_over_norm</Value>
          </QueryParameter>
          <QueryParameter Name="source_warehouse">
            <Value>=Parameters!source_warehouse</Value>
          </QueryParameter>
          <QueryParameter Name="show_closed">
            <Value>=Parameters!show_closed</Value>
          </QueryParameter>
          <QueryParameter Name="start_date">
            <Value>=Parameters!start_date</Value>
          </QueryParameter>
          <QueryParameter Name="finish_date">
            <Value>=Parameters!finish_date</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields >
        <Field Name="source_type">
          <DataField>source_type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="claim_id">
          <DataField>claim_id</DataField>
          <rd:TypeName>System.UInt32</rd:TypeName>
        </Field>
        <Field Name="FIO">
          <DataField>FIO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="tab">
          <DataField>tab</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="phone">
          <DataField>phone</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="subdivision">
          <DataField>subdivision</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="department">
          <DataField>department</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="barcode">
          <DataField>barcode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="nomenclature_name">
          <DataField>nomenclature_name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="dateRepTer">
          <DataField>dateRepTer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="dateAWait">
          <DataField>dateAWait</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="dayWaitServ">
          <DataField>dayWaitServ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="dateDlvLaund">
          <DataField>dateDlvLaund</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="dayDlvLaund">
          <DataField>dayDlvLaund</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="dateInWash">
          <DataField>dateInWash</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="dayWash">
          <DataField>dayWash</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="dateInDry">
          <DataField>dateInDry</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="dayDry">
          <DataField>dayDry</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="dateInRep">
          <DataField>dateInRep</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="dayRep">
          <DataField>dayRep</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="dateDlvDisp">
          <DataField>dateDlvDisp</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="dayDlvDisp">
          <DataField>dayDlvDisp</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="dateInDisp">
          <DataField>dateInDisp</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="dayDisp">
          <DataField>dayDisp</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="dateRet">
          <DataField>dateRet</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="dayService">
          <DataField>dayService</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="lifeTime">
          <DataField>lifeTime</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="defect">
          <DataField>defect</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="need_for_repair">
          <DataField>need_for_repair</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
