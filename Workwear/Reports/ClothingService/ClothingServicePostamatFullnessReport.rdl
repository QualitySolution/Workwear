  <ReportParameters>
    <ReportParameter Name="start_date">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>2026-07-26</Value>
        </Values>
      </DefaultValue>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
      <MultiValue>false</MultiValue>
      <Prompt></Prompt>
    </ReportParameter>
    <ReportParameter Name="finish_date">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>2026-08-25</Value>
        </Values>
      </DefaultValue>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
      <MultiValue>false</MultiValue>
      <Prompt></Prompt>
    </ReportParameter>
    <ReportParameter Name="postomats">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>;2|27;4|6;5|48;6|42;7|39;8|26;9|26;10|25;11|38;13|27;14|62;15|49;16|35;31|20;35|32;40|18;</Value>
        </Values>
      </DefaultValue>
      <Nullable>false</Nullable>
      <AllowBlank>true</AllowBlank>
      <MultiValue>false</MultiValue>
      <Prompt></Prompt>
    </ReportParameter>
    <ReportParameter Name="postomat_ids">
      <DataType>Integer</DataType>
      <DefaultValue>
