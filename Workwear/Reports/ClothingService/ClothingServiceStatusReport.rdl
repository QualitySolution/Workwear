<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description></Description>
  <Author></Author>
  <PageHeight>11in</PageHeight>
  <PageWidth>36.5in</PageWidth>
  <Width>7.5in</Width>
  <TopMargin>.25in</TopMargin>
  <LeftMargin>.25in</LeftMargin>
  <RightMargin>.25in</RightMargin>
  <BottomMargin>.25in</BottomMargin>
  <DataSets>
    <DataSet Name="Data">
      <Query >
        <DataSourceName>DS1</DataSourceName>
        <CommandText>SELECT *
FROM (
SELECT
    -- Источник вещи определяется последней операцией штрихкода.
    CASE
        WHEN warehouse.id IS NOT NULL THEN 'Warehouse'
        WHEN duty_norms.id IS NOT NULL THEN 'DutyNorm'
        WHEN over_norm.id IS NOT NULL THEN 'OverNorm'
        ELSE 'Employee'
    END AS source_type,
    clothing_service_claim.id,
    barcodes.title AS barcode,
    nomenclature.name AS nomenclature,
    CASE finish.state
        WHEN 'WaitService' THEN 'Принята'
        WHEN 'InReceiptTerminal' THEN 'Принят терминалом'
        WHEN 'InTransit' THEN 'В пути'
        WHEN 'DeliveryToLaundry' THEN 'Доставка в прачечную'
        WHEN 'InRepair' THEN 'В ремонте'
        WHEN 'InWashing' THEN 'В стирке'
        WHEN 'InDryCleaning' THEN 'В химчистке'
        WHEN 'AwaitIssue' THEN 'Ожидает выдачи'
        WHEN 'DeliveryToDispenseTerminal' THEN 'Доставка в постамат выдачи'
        WHEN 'InDispenseTerminal' THEN 'В постамате выдачи'
        WHEN 'Returned' THEN 'Возвращена'
        ELSE finish.state END
            AS state_name,
    DATE_FORMAT(start.operation_time, '%d.%m.%Y') AS start_date,
    DATEDIFF(NOW(), start.operation_time) AS day_from_start,
    DATE_FORMAT(finish.operation_time, '%d.%m.%Y') AS finish_date,
    DATEDIFF(NOW(), finish.operation_time) AS day_into_disp_terminal,
    postomat_documents.terminal_location AS disp_location,
    postomat_document_items.cell_number AS disp_cell,
    employees.personnel_number AS tab_num,
    IF(clothing_service_claim.need_for_repair, 'Да', '') AS need_for_repair,
    clothing_service_claim.defect,

    IF(@show_emoloyee,
       CASE
           WHEN warehouse.id IS NOT NULL THEN CONCAT('Склад ', warehouse.name)
           WHEN duty_norms.id IS NOT NULL THEN TRIM(CONCAT('Дежурная №', duty_norms.id, ' ',
               CONCAT_WS(' ',
                   IF(duty_norms.responsible_employee_id IS NOT NULL, responsible_employee.last_name, responsible_leader.surname),
                   CONCAT_WS('',
                       CONCAT(NULLIF(LEFT(IF(duty_norms.responsible_employee_id IS NOT NULL, responsible_employee.first_name, responsible_leader.name), 1), ''), '.'),
                       CONCAT(NULLIF(LEFT(IF(duty_norms.responsible_employee_id IS NOT NULL, responsible_employee.patronymic_name, responsible_leader.patronymic), 1), ''), '.')))))
           WHEN over_norm.id IS NOT NULL THEN CONCAT_WS(' ',
               CASE over_norm.type
                   WHEN 'Guest' THEN 'Гостевая'
                   WHEN 'Substitute' THEN 'Подменная'
                   WHEN 'Simple' THEN 'Разовая'
                   ELSE over_norm.type END,
               employees.last_name,
               CONCAT_WS('',
                   CONCAT(NULLIF(LEFT(employees.first_name, 1), ''), '.'),
                   CONCAT(NULLIF(LEFT(employees.patronymic_name, 1), ''), '.')))
           ELSE CONCAT_WS(' ', employees.last_name, employees.first_name, employees.patronymic_name)
       END, '') AS 'FIO',
    IF(@show_emoloyee, posts.name, '') AS post,
    IF(@show_emoloyee, subdivisions.name, '') AS subdivision,
    IF(@show_emoloyee, departments.name, '') AS department,
    IF(@show_phone, IF(duty_norms.id IS NOT NULL, responsible_employee.phone_number, employees.phone_number), '') AS phone,
    IF(@show_comment, IFNULL(start.comment, ''), '') AS start_comment,
    IF(@show_comment, IFNULL(finish.comment, ''), '') AS finish_comment
FROM clothing_service_claim
         LEFT JOIN (select s.claim_id AS clid, MIN(s.id) AS st_id
                    FROM clothing_service_states AS s
                    GROUP BY s.claim_id
) AS t1 ON t1.clid = clothing_service_claim.id
         LEFT JOIN (select s.claim_id AS clid, MAX(s.id) AS fh_id
                    FROM clothing_service_states AS s
                    GROUP BY s.claim_id
) AS t2 ON t2.clid = clothing_service_claim.id
         LEFT JOIN clothing_service_states AS start ON start.id = t1.st_id
         LEFT JOIN clothing_service_states AS finish ON finish.id = t2.fh_id
         LEFT JOIN barcodes ON clothing_service_claim.barcode_id = barcodes.id
         LEFT JOIN operation_barcodes AS last_operation ON last_operation.id = (
             SELECT ob.id
             FROM operation_barcodes AS ob
                      LEFT JOIN operation_issued_by_employee AS oe ON oe.id = ob.employee_issue_operation_id
                      LEFT JOIN operation_issued_by_duty_norm AS od ON od.id = ob.duty_norm_issue_operation_id
                      LEFT JOIN operation_over_norm AS oo ON oo.id = ob.over_norm_operation_id
                      LEFT JOIN operation_warehouse AS ow ON ow.id = ob.warehouse_operation_id
             WHERE ob.barcode_id = barcodes.id
             ORDER BY COALESCE(oe.operation_time, od.operation_time, oo.operation_time, ow.operation_time) DESC, ob.id DESC
             LIMIT 1
         )
         LEFT JOIN operation_warehouse AS last_warehouse ON last_warehouse.id = last_operation.warehouse_operation_id
         LEFT JOIN warehouse ON warehouse.id = last_warehouse.warehouse_receipt_id
         LEFT JOIN operation_issued_by_duty_norm AS duty_operation ON duty_operation.id = last_operation.duty_norm_issue_operation_id
             AND duty_operation.issued &gt; 0 AND warehouse.id IS NULL
         LEFT JOIN duty_norms ON duty_norms.id = duty_operation.duty_norm_id
         LEFT JOIN leaders AS responsible_leader ON responsible_leader.id = duty_norms.responsible_leder_id
         LEFT JOIN employees AS responsible_employee ON responsible_employee.id = COALESCE(duty_norms.responsible_employee_id, responsible_leader.employee_id)
         LEFT JOIN operation_over_norm AS over_norm ON over_norm.id = last_operation.over_norm_operation_id
             AND warehouse.id IS NULL
         LEFT JOIN employees ON employees.id = CASE
             WHEN warehouse.id IS NOT NULL OR duty_norms.id IS NOT NULL THEN NULL
             WHEN over_norm.id IS NOT NULL THEN over_norm.employee_id
             ELSE clothing_service_claim.employee_id END
         LEFT JOIN posts ON employees.post_id = posts.id
         LEFT JOIN subdivisions ON subdivisions.id = IF(duty_norms.id IS NOT NULL, duty_norms.subdivision_id, employees.subdivision_id)
         LEFT JOIN departments ON employees.department_id = departments.id
         LEFT JOIN nomenclature ON barcodes.nomenclature_id = nomenclature.id
         LEFT JOIN postomat_document_items ON clothing_service_claim.id = postomat_document_items.claim_id
         LEFT JOIN postomat_documents ON postomat_document_items.document_id = postomat_documents.id
WHERE (@all_status OR @status = '' OR finish.state = @status)
  AND (@show_closed OR NOT clothing_service_claim.is_closed)
  AND finish.operation_time &gt;= CONVERT(@start_date, DATE) AND finish.operation_time &lt; DATE_ADD(CONVERT(@finish_date, DATE), INTERVAL 1 DAY)
) AS claims
WHERE (claims.source_type = 'Employee' AND @source_employee)
   OR (claims.source_type = 'DutyNorm' AND @source_duty)
   OR (claims.source_type = 'OverNorm' AND @source_over_norm)
   OR (claims.source_type = 'Warehouse' AND @source_warehouse)
ORDER BY start_date</CommandText>
        <QueryParameters>
          <QueryParameter Name="source_employee">
            <Value>=Parameters!source_employee</Value>
          </QueryParameter>
          <QueryParameter Name="source_duty">
            <Value>=Parameters!source_duty</Value>
          </QueryParameter>
          <QueryParameter Name="source_over_norm">
            <Value>=Parameters!source_over_norm</Value>
          </QueryParameter>
          <QueryParameter Name="source_warehouse">
            <Value>=Parameters!source_warehouse</Value>
          </QueryParameter>
          <QueryParameter Name="status">
            <Value>=Parameters!status</Value>
          </QueryParameter>
          <QueryParameter Name="show_comment">
            <Value>=Parameters!show_comment</Value>
          </QueryParameter>
          <QueryParameter Name="show_phone">
            <Value>=Parameters!show_phone</Value>
          </QueryParameter>
          <QueryParameter Name="start_date">
            <Value>=Parameters!start_date</Value>
          </QueryParameter>
          <QueryParameter Name="finish_date">
            <Value>=Parameters!finish_date</Value>
          </QueryParameter>
          <QueryParameter Name="show_emoloyee">
            <Value>=Parameters!show_emoloyee</Value>
          </QueryParameter>
          <QueryParameter Name="show_closed">
            <Value>=Parameters!show_closed</Value>
          </QueryParameter>
          <QueryParameter Name="all_status">
            <Value>=Parameters!all_status</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields >
        <Field Name="source_type">
          <DataField>source_type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="id">
          <DataField>id</DataField>
          <rd:TypeName>System.UInt32</rd:TypeName>
        </Field>
        <Field Name="barcode">
          <DataField>barcode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="nomenclature">
          <DataField>nomenclature</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="start_date">
          <DataField>start_date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="day_from_start">
          <DataField>day_from_start</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="finish_date">
          <DataField>finish_date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="day_into_disp_terminal">
          <DataField>day_into_disp_terminal</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="disp_location">
          <DataField>disp_location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="disp_cell">
          <DataField>disp_cell</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="tab_num">
          <DataField>tab_num</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FIO">
          <DataField>FIO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="post">
          <DataField>post</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="subdivision">
          <DataField>subdivision</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="department">
          <DataField>department</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="phone">
          <DataField>phone</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="start_comment">
          <DataField>start_comment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="finish_comment">
          <DataField>finish_comment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="state_name">
          <DataField>state_name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="need_for_repair">
          <DataField>need_for_repair</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="defect">
          <DataField>defect</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
