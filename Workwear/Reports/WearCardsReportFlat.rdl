  <LeftMargin>.25in</LeftMargin>
  <RightMargin>.25in</RightMargin>
  <BottomMargin>.25in</BottomMargin>
  <DataSets>
    <DataSet Name="Data">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>SELECT
    Concat_ws(' ', employees.last_name,employees.first_name, employees.patronymic_name) as 'employee_name',
    employees.personnel_number as 'personnel_number',
    posts.name as 'post',
    subdivisions.name as 'subdivision',
    departments.name as 'department',
    DATE_FORMAT(dismiss_date, '%d.%m.%Y') as 'dismiss_date',
    DATE_FORMAT(hire_date, '%d.%m.%Y') as 'hire_date',
    phone_number,
    (SELECT GROUP_CONCAT(CONCAT(n.id, ' - ', n.name) ORDER BY n.name SEPARATOR '\n')
     FROM employees_norms en
          JOIN norms n ON n.id = en.norm_id
     WHERE en.employee_id = employees.id AND n.archival = 0) as 'active_norms'
    FROM employees
         LEFT JOIN subdivisions on employees.subdivision_id = subdivisions.id
         LEFT JOIN departments on employees.department_id = departments.id
         LEFT JOIN posts on posts.id = employees.post_id
WHERE (
        (@only_working AND (employees.hire_date IS NULL OR employees.hire_date &lt;= @actual_date)
                        AND (employees.dismiss_date IS NULL OR employees.dismiss_date &gt; @actual_date))
     OR (@only_hired AND employees.hire_date BETWEEN @hire_from AND @hire_to)
     OR (@only_dismissed AND employees.dismiss_date BETWEEN @dismiss_from AND @dismiss_to)
      )
  AND (
        (@only_without_norms AND NOT EXISTS (SELECT 1 FROM employees_norms en
                                              JOIN norms n ON n.id = en.norm_id
                                              WHERE en.employee_id = employees.id AND n.archival=0))
     OR (@only_with_norms AND EXISTS (SELECT 1 FROM employees_norms en
                                       JOIN norms n ON n.id = en.norm_id
                                       WHERE en.employee_id = employees.id AND n.archival=0))
      )
ORDER BY employee_name;</CommandText>
        <QueryParameters>
          <QueryParameter Name="only_working">
            <Value>={?only_working}</Value>
          </QueryParameter>
          <QueryParameter Name="actual_date">
            <Value>={?actual_date}</Value>
          </QueryParameter>
          <QueryParameter Name="only_hired">
            <Value>={?only_hired}</Value>
          </QueryParameter>
          <QueryParameter Name="hire_from">
            <Value>={?hire_from}</Value>
          </QueryParameter>
          <QueryParameter Name="hire_to">
            <Value>={?hire_to}</Value>
          </QueryParameter>
          <QueryParameter Name="only_dismissed">
            <Value>={?only_dismissed}</Value>
          </QueryParameter>
          <QueryParameter Name="dismiss_from">
            <Value>={?dismiss_from}</Value>
          </QueryParameter>
          <QueryParameter Name="dismiss_to">
            <Value>={?dismiss_to}</Value>
          </QueryParameter>
          <QueryParameter Name="only_without_norms">
            <Value>={?only_without_norms}</Value>
          </QueryParameter>
          <QueryParameter Name="only_with_norms">
            <Value>={?only_with_norms}</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
