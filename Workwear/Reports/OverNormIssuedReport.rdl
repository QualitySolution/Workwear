<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Текущие остатки выдач вне нормы с отдельной строкой на каждый штрихкод.</Description>
  <PageHeight>210mm</PageHeight>
  <PageWidth>400mm</PageWidth>
  <Width>276mm</Width>
  <TopMargin>5mm</TopMargin>
  <LeftMargin>5mm</LeftMargin>
  <RightMargin>5mm</RightMargin>
  <BottomMargin>5mm</BottomMargin>
  <DataSets>
    <DataSet Name="Data">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>WITH issued AS (
    SELECT operation.id, operation.employee_id, operation.nomenclature_id,
           operation.size_id, operation.height_id,
           warehouse.operation_time AS issue_date, warehouse.wear_percent,
           operation.comment AS item_comment, document.comment AS document_comment,
           warehouse.amount - IFNULL(returned.amount, 0) AS balance
    FROM operation_over_norm operation
    JOIN operation_warehouse warehouse ON warehouse.id = operation.operation_warehouse_id
    LEFT JOIN stock_over_norm_items document_item ON document_item.over_norm_operation_id = operation.id
    LEFT JOIN stock_over_norms document ON document.id = document_item.document_id
    LEFT JOIN (
        SELECT return_operation.return_from_operation, SUM(return_warehouse.amount) AS amount
        FROM operation_over_norm return_operation
        JOIN operation_warehouse return_warehouse ON return_warehouse.id = return_operation.operation_warehouse_id
        WHERE return_operation.return_from_operation IS NOT NULL
        GROUP BY return_operation.return_from_operation
    ) returned ON returned.return_from_operation = operation.id
    WHERE operation.return_from_operation IS NULL
      AND warehouse.warehouse_expense_id IS NOT NULL
      AND (-1 IN (@nomenclature_ids) OR operation.nomenclature_id IN (@nomenclature_ids))
), active_barcodes AS (
    SELECT DISTINCT issued.id AS operation_id, barcode.id AS barcode_id, barcode.title
    FROM issued
    JOIN operation_barcodes barcode_operation ON barcode_operation.over_norm_operation_id = issued.id
    JOIN barcodes barcode ON barcode.id = barcode_operation.barcode_id
    WHERE issued.balance &gt; 0
      AND NOT EXISTS (
          SELECT 1
          FROM operation_over_norm return_operation
          JOIN operation_barcodes return_barcode ON return_barcode.over_norm_operation_id = return_operation.id
          WHERE return_operation.return_from_operation = issued.id
            AND return_barcode.barcode_id = barcode.id
      )
), report_rows AS (
    SELECT operation_id, barcode_id, title FROM active_barcodes
    UNION ALL
    -- Отдельная строка для остатка без маркировки, в том числе при смешанной выдаче.
    SELECT issued.id, NULL, NULL
    FROM issued
    LEFT JOIN active_barcodes ON active_barcodes.operation_id = issued.id
    GROUP BY issued.id, issued.balance
    HAVING issued.balance &gt; COUNT(active_barcodes.barcode_id)
)
SELECT nomenclature.name AS nomenclature_name,
       report_rows.title AS barcode,
       wear_size.name AS wear_size, height.name AS height,
       issued.wear_percent,
       CONCAT_WS(' ', employee.last_name, employee.first_name, employee.patronymic_name) AS employee_name,
       employee.personnel_number, employee.phone_number,
       issued.item_comment, issued.document_comment,
       issued.issue_date,
       DATEDIFF(@report_date, issued.issue_date) AS days_issued
FROM issued
JOIN report_rows ON report_rows.operation_id = issued.id
JOIN employees employee ON employee.id = issued.employee_id
JOIN nomenclature ON nomenclature.id = issued.nomenclature_id
LEFT JOIN sizes wear_size ON wear_size.id = issued.size_id
LEFT JOIN sizes height ON height.id = issued.height_id
WHERE issued.balance &gt; 0
ORDER BY nomenclature.name, employee_name, employee.id, issued.issue_date, issued.id, report_rows.title, report_rows.barcode_id</CommandText>
        <QueryParameters>
          <QueryParameter Name="nomenclature_ids">
            <Value>={?nomenclature_ids}</Value>
          </QueryParameter>
          <QueryParameter Name="report_date">
            <Value>={?report_date}</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="nomenclature_name">
          <DataField>nomenclature_name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="barcode">
          <DataField>barcode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="wear_size">
          <DataField>wear_size</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="height">
          <DataField>height</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="wear_percent">
          <DataField>wear_percent</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="employee_name">
          <DataField>employee_name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="personnel_number">
          <DataField>personnel_number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="phone_number">
          <DataField>phone_number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="issue_date">
          <DataField>issue_date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="days_issued">
          <DataField>days_issued</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="item_comment">
          <DataField>item_comment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="document_comment">
          <DataField>document_comment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
